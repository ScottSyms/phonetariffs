{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phonetariffs",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phonetariffs",
      "database_id": "bf318ae2-765f-477b-84b5-f96907aaea70",
      "migrations_dir": "migrations"
    }
  ]
}
